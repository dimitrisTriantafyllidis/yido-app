{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*.yido.gr",
  "Frontend": {
    "Url": "https://yido.gr",
    "ApiUrl": "https://api.yido.gr"
  },
  "Storage": {
    "Provider": "azure",
    "Azure": {
      "ContainerName": "uploads",
      "UseSasUrls": false
    }
  },
  "Stripe": {
    "AllowDevBypass": false
  },
  "Email": {
    "Provider": "SendGrid",
    "From": "noreply@yido.gr",
    "FromName": "YIDO"
  }
}
